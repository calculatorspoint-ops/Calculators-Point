# Firebase browser configuration is public by design. Restrict the API key in
# Google Cloud and enforce authorization with Firebase Security Rules.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional server-side overrides for the contact API. These Firebase web API
# keys are identifiers, not authentication secrets; restrict them in Google
# Cloud and secure database access with Firebase Security Rules. Never expose
# service-account keys or private tokens with NEXT_PUBLIC_ names.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your_api_key_here
